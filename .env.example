# Copia este archivo a .env en la RAIZ del repositorio y completa la contrasena.
# Docker Compose usa estas variables para PostgreSQL y para la API.
# DB_USER/DB_PASSWORD son credenciales de PostgreSQL, no usuarios del frontend.
DB_NAME=nova_sounds
DB_USER=nova_app
DB_PASSWORD=

# Direccion de la aplicacion: http://localhost:8000
APP_PORT=8000

# Si tu contrasena incluye $ o #, usa comillas simples:
# DB_PASSWORD='tu_contrasena_con_caracteres_especiales'
